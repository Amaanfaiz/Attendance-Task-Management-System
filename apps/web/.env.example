# Server-side only: where Next.js's own rewrite proxy forwards /api/v1/* requests.
# The browser never calls this URL directly — it calls the web app's own origin,
# which keeps the auth cookie first-party (see next.config.mjs and lib/api-client.ts).
API_INTERNAL_URL=http://localhost:3001

# Only set this if you deliberately want the browser to call the API's own origin
# directly instead of going through the same-origin proxy above.
# NEXT_PUBLIC_API_URL=http://localhost:3001
