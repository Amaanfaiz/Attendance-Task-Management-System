DATABASE_URL=postgresql://atms:atms_dev_password@localhost:5432/atms?schema=public
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# 'lax' for same-origin local dev. Set to 'none' whenever the API and web app are on
# different origins (e.g. Azure Container Apps' separate *.azurecontainerapps.io
# subdomains, or this tunnel demo) — 'none' forces Secure regardless of COOKIE_SECURE,
# since browsers reject SameSite=None without it.
COOKIE_SAME_SITE=lax
# Optional - email channel (password reset links, task/reminder notifications).
# Unset in dev/test on purpose: EmailService treats a missing connection string as
# "not configured" and skips sending instead of throwing. Azure Communication
# Services Email connection string; EMAIL_FROM must be a verified sender address
# on that ACS resource's linked domain, as a bare address - ACS's senderAddress
# field does not accept a "Display Name <addr>" form the way Resend's did.
ACS_EMAIL_CONNECTION_STRING=
EMAIL_FROM=DoNotReply@azurecomm.net
