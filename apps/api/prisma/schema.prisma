generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  ADMINISTRATOR
  AUDITOR
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  REJECTED
}

enum AttendanceSessionStatus {
  ACTIVE
  ON_BREAK
  COMPLETED
}

enum BreakRecordStatus {
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskTimeEntryStatus {
  RUNNING
  CLOSED
}

enum CorrectionTargetType {
  ATTENDANCE_SESSION
  BREAK_RECORD
  TASK_TIME_ENTRY
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users User[]

  @@map("departments")
}

model User {
  id             String     @id @default(uuid())
  firstName      String
  surname        String
  email          String     @unique
  phoneNumber    String
  passwordHash   String
  role           UserRole   @default(EMPLOYEE)
  status         UserStatus @default(PENDING)
  employeeNumber String?    @unique
  departmentId   String?

  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  approvedBy User?       @relation("UserApprovals", fields: [approvedById], references: [id])
  approvals  User[]      @relation("UserApprovals")

  attendanceSessions   AttendanceSession[]
  createdTasks         Task[]               @relation("TaskCreator")
  assignedTasks        Task[]               @relation("TaskAssignee")
  taskTimeEntries      TaskTimeEntry[]
  correctionsRequested CorrectionRequest[]  @relation("CorrectionRequester")
  correctionsDecided   CorrectionRequest[]  @relation("CorrectionDecider")
  auditLogs            AuditLog[]
  passwordResetTokens  PasswordResetToken[]
  refreshTokens        RefreshToken[]
  notifications        Notification[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AttendanceSession {
  id          String                   @id @default(uuid())
  userId      String
  clockInAt   DateTime
  clockOutAt  DateTime?
  status      AttendanceSessionStatus  @default(ACTIVE)
  createdAt   DateTime                 @default(now())

  user            User             @relation(fields: [userId], references: [id])
  breaks          BreakRecord[]
  taskTimeEntries TaskTimeEntry[]

  // BR-002: at most one ACTIVE/ON_BREAK attendance session per user, enforced via
  // a partial unique index created in the migration SQL (Prisma can't express partial
  // indexes declaratively pre-5.x preview flag), see migration.sql for the CREATE UNIQUE INDEX.
  @@index([userId, status])
  @@map("attendance_sessions")
}

model BreakRecord {
  id                  String             @id @default(uuid())
  attendanceSessionId String
  startAt             DateTime
  endAt               DateTime?
  status              BreakRecordStatus  @default(ACTIVE)

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id])

  @@index([attendanceSessionId, status])
  @@map("break_records")
}

model Task {
  id                String       @id @default(uuid())
  title             String
  description       String?
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(TO_DO)
  dueDate           DateTime?
  estimatedMinutes  Int?
  completedAt       DateTime?

  createdById String
  assigneeId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy       User            @relation("TaskCreator", fields: [createdById], references: [id])
  assignee        User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  taskTimeEntries TaskTimeEntry[]
  notifications   Notification[]

  @@index([assigneeId, status])
  @@map("tasks")
}

model TaskTimeEntry {
  id                  String               @id @default(uuid())
  taskId              String
  userId              String
  attendanceSessionId String
  startAt             DateTime
  endAt               DateTime?
  status              TaskTimeEntryStatus  @default(RUNNING)

  task              Task              @relation(fields: [taskId], references: [id])
  user              User              @relation(fields: [userId], references: [id])
  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id])

  // BR-003: at most one RUNNING task time entry per user, enforced via a partial
  // unique index in migration.sql.
  @@index([userId, status])
  @@index([taskId])
  @@map("task_time_entries")
}

model CorrectionRequest {
  id             String                @id @default(uuid())
  requestedById  String
  targetType     CorrectionTargetType
  targetId       String
  proposedStart  DateTime?
  proposedEnd    DateTime?
  reason         String
  status         CorrectionStatus      @default(PENDING)

  decidedById      String?
  decidedAt        DateTime?
  decisionComment  String?

  createdAt DateTime @default(now())

  requestedBy User  @relation("CorrectionRequester", fields: [requestedById], references: [id])
  decidedBy   User? @relation("CorrectionDecider", fields: [decidedById], references: [id])

  @@index([status])
  @@map("correction_requests")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  targetType   String
  targetId     String?
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Singleton row (id always "default") holding organisation-wide toggles referenced
// by AC-001-001-04 and AC-005-002-01.
model AppSettings {
  id                                String  @id @default("default")
  requireRegistrationApproval       Boolean @default(true)
  employeesCanCreateTasks           Boolean @default(true)
  sessionInactivityTimeoutMinutes   Int     @default(30)
  missingClockOutThresholdMinutes   Int     @default(600)
  longRunningTimerThresholdMinutes  Int     @default(240)
  longRunningTimerCooldownMinutes   Int     @default(60)
  unallocatedTimeThresholdMinutes   Int     @default(30)
  unallocatedReminderCutoffHourUtc  Int     @default(6)
  notificationsEmailEnabled         Boolean @default(false)

  @@map("app_settings")
}

enum NotificationType {
  TASK_ASSIGNED
  MISSING_CLOCK_OUT
  LONG_RUNNING_TIMER
  UNALLOCATED_TIME
}

// EP-011: durable in-app notifications, created by a real task reassignment or by the
// reminder-scanning cron (notifications.service.ts). dedupeKey guards against spamming
// the same event twice - see notifications.service.ts for the exact key per type.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  taskId    String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, dedupeKey])
  @@map("notifications")
}
